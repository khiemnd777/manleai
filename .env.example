COMPOSE_PROJECT_NAME=manleai

POSTGRES_USER=ai_receptionist
POSTGRES_PASSWORD=ai_receptionist
POSTGRES_DB=ai_receptionist
POSTGRES_PORT=55432
REDIS_PORT=56379

APP_ENV=local
API_PORT=18089
SERVER_PORT=8080
FRONTEND_PORT=3088
LANDING_PORT=3090
POS_CALENDAR_PORT=3091
DATABASE_URL=postgres://ai_receptionist:ai_receptionist@postgres:5432/ai_receptionist?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=720
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=http://localhost:3088,http://localhost:3090,http://localhost:3091
FRONTEND_URL=http://localhost:3088
LANDING_API_BASE_URL=http://api:8080

# Optional provider fallbacks. Prefer configuring these in the Integrations dashboard.
SQUARE_ENVIRONMENT=sandbox
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_REDIRECT_URL=http://localhost:18089/api/integrations/square/callback
SQUARE_API_VERSION=2026-05-20

# Optional voice provider fallbacks. Prefer configuring these in the Integrations dashboard.
VOICE_PROVIDER=twilio
VOICE_PUBLIC_BASE_URL=http://localhost:18089
VOICE_TWILIO_AUTH_TOKEN=
VOICE_TWILIO_INCOMING_PATH=/api/voice/twilio/incoming
VOICE_TWILIO_TURN_PATH=/api/voice/twilio/turn
VOICE_TWILIO_RECORDING_PATH=/api/voice/twilio/recording
VOICE_AI_PROVIDER=
VOICE_OPENAI_API_KEY=
VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
VOICE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_OPENAI_REPLY_MODEL=gpt-4.1-mini
VOICE_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
VOICE_OPENAI_SPEECH_VOICE=alloy

NEXT_PUBLIC_API_BASE_URL=http://localhost:18089
NEXT_PUBLIC_LANDING_BASE_URL=http://localhost:3090
