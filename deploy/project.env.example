# Copy this file to project.env, replace every secret placeholder, then store
# the base64-encoded file as the GitHub secret PROJECT_ENV_B64.

COMPOSE_PROJECT_NAME=manleai

ADMIN_DOMAIN=ai.knasoftware.com
LANDING_DOMAIN=salon.knasoftware.com
POS_DOMAIN=pos.knasoftware.com

API_BIND_HOST=127.0.0.1
API_PORT=18089
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=13088
LANDING_BIND_HOST=127.0.0.1
LANDING_PORT=13090
POS_CALENDAR_BIND_HOST=127.0.0.1
POS_CALENDAR_PORT=13091

POSTGRES_USER=ai_receptionist
POSTGRES_PASSWORD=replace-with-url-safe-postgres-password
POSTGRES_DB=ai_receptionist
DATABASE_RUNTIME_ROLE=manleai_runtime
DATABASE_RUNTIME_PASSWORD=replace-with-separate-url-safe-runtime-password

APP_ENV=production
DATABASE_URL=postgres://manleai_runtime:replace-with-separate-url-safe-runtime-password@postgres:5432/ai_receptionist?sslmode=disable
MIGRATION_DATABASE_URL=postgres://ai_receptionist:replace-with-url-safe-postgres-password@postgres:5432/ai_receptionist?sslmode=disable
DATABASE_RLS_ENFORCED=true
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLIENT_IP_HEADER=X-ManleAI-Client-IP
JWT_SECRET=replace-with-long-random-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=720
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=https://ai.knasoftware.com,https://salon.knasoftware.com,https://pos.knasoftware.com
FRONTEND_URL=https://ai.knasoftware.com

NEXT_PUBLIC_API_BASE_URL=https://ai.knasoftware.com
NEXT_PUBLIC_LANDING_BASE_URL=https://salon.knasoftware.com
LANDING_API_BASE_URL=http://api:8080
