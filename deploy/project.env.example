# Copy this file to project.env, replace every secret placeholder, then store
# the base64-encoded file as the GitHub secret PROJECT_ENV_B64.

COMPOSE_PROJECT_NAME=manleai

ADMIN_DOMAIN=ai.knasoftware.com
LANDING_DOMAIN=salon.knasoftware.com
CADDY_EMAIL=admin@knasoftware.com

POSTGRES_USER=ai_receptionist
POSTGRES_PASSWORD=replace-with-url-safe-postgres-password
POSTGRES_DB=ai_receptionist

APP_ENV=production
DATABASE_URL=postgres://ai_receptionist:replace-with-url-safe-postgres-password@postgres:5432/ai_receptionist?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-long-random-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=720
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=https://ai.knasoftware.com,https://salon.knasoftware.com
FRONTEND_URL=https://ai.knasoftware.com

NEXT_PUBLIC_API_BASE_URL=https://ai.knasoftware.com
NEXT_PUBLIC_LANDING_BASE_URL=https://salon.knasoftware.com
LANDING_API_BASE_URL=http://api:8080

# Prefer configuring Square, Twilio, and OpenAI through the Integrations
# dashboard. These environment values are bootstrap or fallback settings.
SQUARE_ENVIRONMENT=production
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_REDIRECT_URL=https://ai.knasoftware.com/api/integrations/square/callback
SQUARE_API_VERSION=2026-05-20

VOICE_PROVIDER=twilio
VOICE_PUBLIC_BASE_URL=https://ai.knasoftware.com
VOICE_TWILIO_AUTH_TOKEN=
VOICE_TWILIO_INCOMING_PATH=/api/voice/twilio/incoming
VOICE_TWILIO_TURN_PATH=/api/voice/twilio/turn
VOICE_TWILIO_RECORDING_PATH=/api/voice/twilio/recording
VOICE_AI_PROVIDER=
VOICE_OPENAI_API_KEY=
VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
VOICE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_OPENAI_REPLY_MODEL=gpt-4.1-mini
VOICE_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
VOICE_OPENAI_SPEECH_VOICE=alloy
